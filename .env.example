# Copy to .env.local for local development.
# Set the same keys in Vercel → Project Settings → Environment Variables.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Production site origin used in auth email redirects (no trailing slash).
# Example: https://tutortrack-five.vercel.app
VITE_SITE_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Google OAuth / Forms (Stages 2B–2C) — set as Supabase Edge Function secrets.
# NEVER add GOOGLE_CLIENT_SECRET to Vite / Vercel frontend env vars.
#
#   supabase secrets set GOOGLE_CLIENT_ID=...
#   supabase secrets set GOOGLE_CLIENT_SECRET=...
#   supabase secrets set SITE_URL=https://your-production-domain
#   supabase secrets set GOOGLE_REDIRECT_URI=https://YOUR_PROJECT.supabase.co/functions/v1/google-oauth-callback
#
# Deploy functions:
#   supabase functions deploy google-oauth-start
#   supabase functions deploy google-oauth-callback
#   supabase functions deploy publish-google-form
#
# Google Cloud Console → OAuth client → Authorized redirect URIs must match
# GOOGLE_REDIRECT_URI exactly.
#
# After adding the spreadsheets scope, tutors who connected earlier should
# disconnect and reconnect Google once so offline access includes Sheets.
# -----------------------------------------------------------------------------
